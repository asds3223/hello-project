+// Cheap local shape estimator used only for move ordering/pruning. Exact wins and
+// Renju forbidden moves are still decided by RenjuRules. The important difference
+// from the old neighbour-only ordering is that broken/open threes are visible.
+int local_shape_score(const Position& pos,Move m,Color c){
+    if(!m.valid() || !pos.empty(m.sq)) return 0;
+    const Cell me=cell_of(c);
+    int score=0;
+    constexpr std::array<int,4> dirs{1,16,17,15};
