+        // A useful three through m needs at least one nearby own stone. This bitboard
+        // density gate avoids line-window work for the majority of quiet candidates.
+        if(pos.line_neighbor_count4_dir(m.sq,c,static_cast<int>(di))==0) continue;
+        const int d=dirs[di];
+        for(int start=-4;start<=0;++start){
+            int own=0,empty=0; bool blocked=false;
+            for(int i=0;i<5;++i){
+                const int sq=m.sq+(start+i)*d;
+                if(!valid_sq(sq)){blocked=true;break;}
+                const Cell cc=(sq==m.sq)?me:pos.at(sq);
+                if(cc==me) ++own;
+                else if(cc==Cell::Empty) ++empty;
+                else {blocked=true;break;}
+            }
+            if(blocked) continue;
+            if(own>=5) score+=180000;
+            else if(own==4 && empty==1) score+=36000;
+            else if(own==3 && empty==2) score+=5200;
+            else if(own==2 && empty==3) score+=260;
+        }
+        // Open-ended six-cell motifs distinguish genuinely dangerous broken/open
+        // threes from random 3-of-5 windows without invoking recursive legality.
+        for(int start=-5;start<=0;++start){
+            const int a=m.sq+start*d, b=a+5*d;
+            if(!valid_sq(a)||!valid_sq(b)) continue;
+            const Cell ca=(a==m.sq)?me:pos.at(a);
+            const Cell cb=(b==m.sq)?me:pos.at(b);
+            if(ca!=Cell::Empty || cb!=Cell::Empty) continue;
+            int own=0,empty=0; bool blocked=false,contains=false;
+            for(int i=1;i<5;++i){
+                const int sq=a+i*d; contains|=sq==m.sq;
+                if(!valid_sq(sq)){blocked=true;break;}
+                const Cell cc=(sq==m.sq)?me:pos.at(sq);
+                if(cc==me) ++own;
+                else if(cc==Cell::Empty) ++empty;
+                else {blocked=true;break;}
+            }
+            if(blocked || !contains) continue;
+            if(own==4) score+=95000;
+            else if(own==3 && empty==1) score+=14500;
+            else if(own==2 && empty==2) score+=800;
+        }
+    }
+    return std::min(score,240000);
+}
